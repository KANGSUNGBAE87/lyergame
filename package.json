{
  "name": "liar-game",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "라이어 게임 - 진행자 없이 즐기는 파티 게임 (앱인토스 미니앱)",
  "scripts": {
    "dev": "granite dev",
    "dev:web": "vite --port 5173",
    "build": "ait build",
    "build:web": "vite build",
    "build:play:web": "vite build --mode google-play",
    "sync:android": "npm run build:play:web && cap sync android",
    "build:android:debug": "npm run sync:android && cd android && ./gradlew assembleDebug",
    "build:android:bundle": "npm run sync:android && cd android && ./gradlew bundleRelease",
    "assets:play": "node scripts/generate-google-play-assets.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.0",
    "@vitejs/plugin-react": "^4.3.0",
    "sharp": "^0.34.5",
    "vite": "^6.0.0",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@apps-in-toss/web-framework": "^2.6.1",
    "@capacitor/android": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
